`timescale 1ns / 1ps

module stuck_both(
    input wire clk,
    input wire sw7,
    input wire sw8,
    output wire led7,
    output wire led8,
    output wire pmod_out,
    output wire raw_clk_out
);

reg [23:0] counter = 0;
reg blink = 0;

always @(posedge clk) begin
    if(counter == 24'd4_999_999) begin
        counter <= 0;
        blink <= ~blink;
    end else begin
        counter <= counter + 1;
    end
end

wire stuck1_signal = sw7 ? 1'b1 : blink;
wire stuck0_signal = sw8 ? 1'b0 : blink;

assign led7 = stuck1_signal;
assign led8 = stuck0_signal;
assign pmod_out = sw7 ? 1'b1 : (sw8 ? 1'b0 : blink);
assign raw_clk_out = clk;

endmodule
