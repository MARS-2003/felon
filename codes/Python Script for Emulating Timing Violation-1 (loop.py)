#!/usr/bin/env python3
import subprocess, time, os, signal
QEMU_CMD = [
"qemu-system-riscv64",
"-machine", "virt,accel=tcg",
"-cpu", "rv64",
"-m", "2048",
"-kernel", os.path.expanduser("~/kernel-build/linux-6.14.5/arch/riscv/boot/Image"),
"-drive", f"file={os.path.expanduser('~/ubuntu-24.04.2-preinstalled-server-riscv64+nezha.img')},f>
"root=/dev/vda1 console=ttyS0,115200 rw rootwait",
"-serial", "file:/mnt/f/loggins/console_log_timi.txt",
"-nographic",
"-qmp", "unix:/tmp/qmp-sock,server=on,wait=off"
]
ITERATIONS = 3
for i in range(ITERATIONS):
print(f"\n--- Starting QEMU for Iteration {i+1} ---")
try:
if os.path.exists("/tmp/qmp-sock"):
os.remove("/tmp/qmp-sock")
qemu = subprocess.Popen(QEMU_CMD)
time.sleep(6) # Boot delay
print(f"--- Running timi.py (Iteration {i+1}) ---")
subprocess.run(["python3", "timi.py"], check=True)
finally:
print(f"--- Killing QEMU (Iteration {i+1}) ---")
qemu.send_signal(signal.SIGTERM)
qemu.wait()
time.sleep(2)
