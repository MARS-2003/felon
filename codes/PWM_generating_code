#!/usr/bin/env python3
import os, time

# List of GPIOs to toggle together
gpios = [79, 232, 13, 15] #board pin 12, 16, 18, 22
period = 1.0 / 500   # 500 Hz
on = period / 2
off = period / 2

# --- Setup ---
for g in gpios:
    os.system(f"echo {g} > /sys/class/gpio/export 2>/dev/null || true")
    os.system(f"echo out > /sys/class/gpio/gpio{g}/direction")

paths = [f"/sys/class/gpio/gpio{g}/value" for g in gpios]

print(f"Generating {1/period:.0f} Hz PWM on GPIOs {gpios}. Ctrl+C to stop.")
try:
    while True:
        # HIGH
        for p in paths:
            with open(p, "w") as f: f.write("1")
        time.sleep(on)

        # LOW
        for p in paths:
            with open(p, "w") as f: f.write("0")
        time.sleep(off)

except KeyboardInterrupt:
    print("\nStopping...")
    for p in paths:
        with open(p, "w") as f: f.write("0")
    print("All pins LOW. Done.")
