import onnxruntime as ort
import numpy as np
import cv2
from IPython.display import HTML, display
from google.colab import files
from base64 import b64encode

# ---------------- USER SETTINGS ----------------
ONNX_MODEL = "/content/my_model.onnx"
IMG_SIZE = 256
CLASS_CONF_THRES = 0.60
OBJ_THRES = 0.25
TOP_K = 60

# --- class names from your data.yaml ---
CLASS_NAMES = ['_track', 'car', 'duck', 'person', 'trafifc_sign']

# ---------------- UTILS ----------------
def sigmoid(x):
    return 1 / (1 + np.exp(-x))

def xywh2xyxy(xywh):
    xc, yc, w, h = xywh[:,0], xywh[:,1], xywh[:,2], xywh[:,3]
    x1 = xc - 0.5 * w
    y1 = yc - 0.5 * h
    x2 = xc + 0.5 * w
    y2 = yc + 0.5 * h
    return np.stack([x1, y1, x2, y2], axis=1)

def nms_numpy(boxes, scores, iou_thres):
    if boxes.shape[0] == 0:
        return np.array([], dtype=np.int32)
    x1, y1, x2, y2 = boxes[:,0], boxes[:,1], boxes[:,2], boxes[:,3]
    areas = (x2 - x1) * (y2 - y1)
    order = scores.argsort()[::-1]
    keep = []
    while order.size > 0:
        i = order[0]
        keep.append(i)
        if order.size == 1:
            break
        xx1 = np.maximum(x1[i], x1[order[1:]])
        yy1 = np.maximum(y1[i], y1[order[1:]])
        xx2 = np.minimum(x2[i], x2[order[1:]])
        yy2 = np.minimum(y2[i], y2[order[1:]])
        w = np.maximum(0.0, xx2 - xx1)
        h = np.maximum(0.0, yy2 - yy1)
        inter = w * h
        iou = inter / (areas[i] + areas[order[1:]] - inter + 1e-9)
        inds = np.where(iou <= iou_thres)[0]
        order = order[inds + 1]
    return np.array(keep, dtype=np.int32)

# ---------------- LOAD MODEL ----------------
providers = ['CUDAExecutionProvider', 'CPUExecutionProvider']
sess = ort.InferenceSession(ONNX_MODEL, providers=providers)
input_name = sess.get_inputs()[0].name
output_name = sess.get_outputs()[0].name
_, C, H_model, W_model = sess.get_inputs()[0].shape
print(f"Model input shape: (C,H,W)=({C},{H_model},{W_model})")

# ---------------- UPLOAD VIDEO ----------------
uploaded = files.upload()
VIDEO_PATH = list(uploaded.keys())[0]
print("Using video:", VIDEO_PATH)

cap = cv2.VideoCapture(VIDEO_PATH)
fourcc = cv2.VideoWriter_fourcc(*'mp4v')
out_path = "/content/video_output.mp4"
fps = cap.get(cv2.CAP_PROP_FPS)
width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
out_video = cv2.VideoWriter(out_path, fourcc, fps, (width, height))

frame_idx = 0
while True:
    ret, frame = cap.read()
    if not ret:
        break
    H_img, W_img = frame.shape[:2]
    img_resized = cv2.resize(frame, (W_model, H_model))
    img_rgb = cv2.cvtColor(img_resized, cv2.COLOR_BGR2RGB)
    inp = img_rgb.astype(np.float32) / 255.0
    inp = inp.transpose(2,0,1)[None, ...]  # (1,C,H,W)

    # ---------------- INFERENCE ----------------
    outs = sess.run([output_name], {input_name: inp})
    preds = outs[0].transpose(0,2,1)[0]

    # ---------------- DECODE ----------------
    xywh = preds[:,:4]
    obj_raw = preds[:,4]
    class_raw = preds[:,5:]

    obj_sig = sigmoid(obj_raw)
    cls_sig = sigmoid(class_raw)
    cls_max = cls_sig.max(axis=1)
    cls_argmax = np.argmax(cls_sig, axis=1)
    rank_scores = obj_sig * cls_max

    # top-K
    k = min(TOP_K, len(rank_scores))
    topk_idx = np.argpartition(-rank_scores, k-1)[:k]
    cand_xywh = xywh[topk_idx]
    cand_scores = cls_max[topk_idx]
    cand_obj = obj_sig[topk_idx]
    cand_cls = cls_argmax[topk_idx]

    # thresholding
    mask = (cand_scores >= CLASS_CONF_THRES) & (cand_obj >= OBJ_THRES)
    cand_boxes = cand_xywh[mask]
    cand_scores = cand_scores[mask]
    cand_cls = cand_cls[mask]

    # convert to xyxy
    cand_boxes_xyxy = xywh2xyxy(cand_boxes)

    # NMS
    keep = nms_numpy(cand_boxes_xyxy, cand_scores, iou_thres=0.45)
    cand_boxes_xyxy = cand_boxes_xyxy[keep]
    cand_scores = cand_scores[keep]
    cand_cls = cand_cls[keep]

    # scale to original
    sx = W_img / W_model
    sy = H_img / H_model
    boxes_img = cand_boxes_xyxy.copy()
    boxes_img[:,[0,2]] *= sx
    boxes_img[:,[1,3]] *= sy

    # draw boxes
    for box, score, cid in zip(boxes_img, cand_scores, cand_cls):
        x1, y1, x2, y2 = map(int, box)
        cv2.rectangle(frame, (x1,y1), (x2,y2), (16,200,16), 2)
        label = f"{CLASS_NAMES[cid] if cid < len(CLASS_NAMES) else cid}:{score:.2f}"
        cv2.putText(frame, label, (x1, max(0,y1-6)), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255,255,255), 1)

    out_video.write(frame)
    frame_idx += 1
    if frame_idx % 30 == 0:
        print(f"Processed {frame_idx} frames...")

cap.release()
out_video.release()
print("Video saved to:", out_path)

# display in Colab
