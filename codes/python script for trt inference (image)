

import os
import cv2
import numpy as np
import tensorrt as trt
import pycuda.driver as cuda
import pycuda.autoinit

# ---------------- USER SETTINGS ----------------
ENGINE_PATH = os.path.expanduser("~/Downloads/onnx/my_model.engine")
IMG_PATH = os.path.expanduser("~/Downloads/onnx/test.jpg")
CLASSES_TXT = os.path.expanduser("~/Downloads/onnx/classes.txt")
BATCH = 1
# thresholds
CLASS_CONF_THRES = 0.55
OBJ_THRES = 0.25
NMS_IOU = 0.45
MIN_BOX_AREA = 16
TOP_K = 60
PRE_N = 200
# EMA grid (not critical for single image, but kept)
EMA_ALPHA = 0.2
EMA_THRESH = 0.03
GRID_SUBSAMPLE = 8
# -----------------------------------------------

# --- utils ---
def sigmoid(x):
    return 1.0 / (1.0 + np.exp(-x))

def load_class_names(path):
    if os.path.isfile(path):
        with open(path, "r") as f:
            names = [x.strip() for x in f.readlines() if x.strip()]
        if names:
            return names
    return [f"class_{i}" for i in range(256)]

CLASS_NAMES = load_class_names(CLASSES_TXT)

def xywh2xyxy(xywh):
    xc, yc, w, h = xywh[:,0], xywh[:,1], xywh[:,2], xywh[:,3]
    x1 = xc - 0.5 * w
    y1 = yc - 0.5 * h
    x2 = xc + 0.5 * w
    y2 = yc + 0.5 * h
    return np.stack([x1, y1, x2, y2], axis=1)

def nms_numpy(boxes, scores, iou_thres):
    if boxes.shape[0] == 0:
        return np.array([], dtype=np.int32)
    x1, y1, x2, y2 = boxes[:,0], boxes[:,1], boxes[:,2], boxes[:,3]
    areas = (x2 - x1) * (y2 - y1)
    order = scores.argsort()[::-1]
    keep = []
    while order.size > 0:
        i = order[0]
        keep.append(i)
        if order.size == 1:
            break
        xx1 = np.maximum(x1[i], x1[order[1:]])
        yy1 = np.maximum(y1[i], y1[order[1:]])
        xx2 = np.minimum(x2[i], x2[order[1:]])
        yy2 = np.minimum(y2[i], y2[order[1:]])
        w = np.maximum(0.0, xx2 - xx1)
        h = np.maximum(0.0, yy2 - yy1)
        inter = w * h
        iou = inter / (areas[i] + areas[order[1:]] - inter + 1e-9)
        inds = np.where(iou <= iou_thres)[0]
        order = order[inds + 1]
    return np.array(keep, dtype=np.int32)

# --- load engine ---
if not os.path.isfile(ENGINE_PATH):
    raise SystemExit("Engine file not found: " + ENGINE_PATH)

TRT_LOGGER = trt.Logger(trt.Logger.WARNING)
with open(ENGINE_PATH, "rb") as f, trt.Runtime(TRT_LOGGER) as runtime:
    engine = runtime.deserialize_cuda_engine(f.read())

context = engine.create_execution_context()

# bindings
input_idx = None
output_idx = None
for i in range(engine.num_bindings):
    if engine.binding_is_input(i):
        input_idx = i
    else:
        output_idx = i

if input_idx is None or output_idx is None:
    raise SystemExit("Cannot find input/output bindings")

in_shape = tuple(int(x) for x in engine.get_binding_shape(input_idx))
out_shape = tuple(int(x) for x in engine.get_binding_shape(output_idx))
_, C, H_model, W_model = in_shape
print(f"Engine input: (C,H,W)=({C},{H_model},{W_model}) output shape={out_shape}")

# allocate buffers
stream = cuda.Stream()
bindings = [None] * engine.num_bindings
host_buffers = {}
dev_buffers = {}

for i in range(engine.num_bindings):
    shape = tuple(int(x) if int(x)>0 else 1 for x in engine.get_binding_shape(i))
    dtype_np = trt.nptype(engine.get_binding_dtype(i))
    size = int(np.prod(shape))
    host_mem = cuda.pagelocked_empty(size, dtype_np)
    dev_mem = cuda.mem_alloc(host_mem.nbytes)
    bindings[i] = int(dev_mem)
    host_buffers[i] = (host_mem, shape)
    dev_buffers[i] = dev_mem

# read image
img = cv2.imread(IMG_PATH)
if img is None:
    raise SystemExit(f"Cannot read image: {IMG_PATH}")

H_img, W_img = img.shape[:2]
img_resized = cv2.resize(img, (W_model, H_model))
img_rgb = cv2.cvtColor(img_resized, cv2.COLOR_BGR2RGB)
arr = img_rgb.astype(np.float32) / 255.0
arr = arr.transpose(2,0,1)
inp = np.ascontiguousarray(arr.reshape(BATCH, C, H_model, W_model))

# copy input
in_host, _ = host_buffers[input_idx]
np.copyto(np.frombuffer(in_host, dtype=inp.dtype, count=inp.size), inp.ravel())
cuda.memcpy_htod_async(dev_buffers[input_idx], in_host, stream)

# inference
context.execute_async_v2(bindings=bindings, stream_handle=stream.handle)

# get output
out_host, out_shape_buf = host_buffers[output_idx]
cuda.memcpy_dtoh_async(out_host, dev_buffers[output_idx], stream)
stream.synchronize()

flat = np.array(out_host, copy=False)
preds = flat.reshape(out_shape_buf).transpose(0,2,1)[0]  # (N,C_out)

# decode
xywh = preds[:,:4]
obj_raw = preds[:,4]
class_raw = preds[:,5:]

obj_sig = sigmoid(obj_raw)
cls_sig = sigmoid(class_raw)
cls_max = cls_sig.max(axis=1)
cls_argmax = np.argmax(cls_sig, axis=1)
rank_scores = obj_sig * cls_max

# prune top PRE_N
N_total = rank_scores.shape[0]
k = min(PRE_N, N_total)
if k < N_total:
    topk_idx = np.argpartition(-rank_scores, k-1)[:k]
    topk_scores = rank_scores[topk_idx]
    order = topk_scores.argsort()[::-1]
    cand_idx = topk_idx[order]
else:
    cand_idx = np.arange(N_total)

cand_xywh = xywh[cand_idx]
cand_boxes = xywh2xyxy(cand_xywh)
cand_scores = cls_max[cand_idx]
cand_obj = obj_sig[cand_idx]
cand_cls = cls_argmax[cand_idx]

# thresholding
mask = (cand_scores >= CLASS_CONF_THRES) & (cand_obj >= OBJ_THRES)
cand_boxes = cand_boxes[mask]
cand_scores = cand_scores[mask]
cand_cls = cand_cls[mask]

# drop tiny boxes
areas = (cand_boxes[:,2]-cand_boxes[:,0])*(cand_boxes[:,3]-cand_boxes[:,1])
keep_area = np.where(areas >= MIN_BOX_AREA)[0]
cand_boxes = cand_boxes[keep_area]
cand_scores = cand_scores[keep_area]
cand_cls = cand_cls[keep_area]

# top-K
if cand_boxes.shape[0] > TOP_K:
    idx_topk = np.argsort(-cand_scores)[:TOP_K]
    cand_boxes = cand_boxes[idx_topk]
    cand_scores = cand_scores[idx_topk]
    cand_cls = cand_cls[idx_topk]

# final NMS
keep = nms_numpy(cand_boxes, cand_scores, NMS_IOU)
cand_boxes = cand_boxes[keep]
cand_scores = cand_scores[keep]
cand_cls = cand_cls[keep]

# scale boxes back to original image
sx = W_img / W_model
sy = H_img / H_model
boxes_img = cand_boxes.copy()
boxes_img[:,[0,2]] *= sx
boxes_img[:,[1,3]] *= sy

# draw boxes
for box, score, cid in zip(boxes_img, cand_scores, cand_cls):
    x1, y1, x2, y2 = map(int, box)
    cv2.rectangle(img, (x1,y1), (x2,y2), (16,200,16), 2)
    label = f"{CLASS_NAMES[cid] if cid < len(CLASS_NAMES) else cid}:{score:.2f}"
    cv2.putText(img, label, (x1, max(0,y1-6)), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255,255,255), 1)

# show/save
cv2.imshow("YOLOv11s TRT", img)
cv2.imwrite("test_output.jpg", img)
print(f"Detections: {len(cand_boxes)}")
cv2.waitKey(0)
cv2.destroyAllWindows()
